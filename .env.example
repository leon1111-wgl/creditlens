# Documentation only: the app does not automatically load this file.
# Demo identities are simulated; keep the service bound to localhost.
CREDITLENS_AUTH_MODE=demo
# For API-key mode, supply hashed random keys through your environment or secret manager:
# CREDITLENS_AUTH_MODE=api_key
# CREDITLENS_PRINCIPALS=[{"key_sha256":"<SHA256 of a random secret>","user_id":"analyst-a","tenant_id":"team-a","role":"analyst"},{"key_sha256":"<different SHA256>","user_id":"reviewer-b","tenant_id":"team-a","role":"reviewer"}]
# Optional local inference adapter; these lines do not start or rent a server.
# CREDITLENS_MODEL_BASE_URL=http://127.0.0.1:8000/v1
# CREDITLENS_MODEL=<served-model-name>
